# Required for /chat
ANTHROPIC_API_KEY=

# Strongly recommended in production — when set, all routes except /health
# require header: X-Max-Api-Key: <value>  (or Authorization: Bearer <value>)
MAX_API_KEY=

# Optional model override (pass-through defaults to claude-sonnet-4-6;
# legacy /chat without system defaults to claude-haiku-4-5)
CLAUDE_MODEL=

# Sunfire session credentials (provider + drug lookup). Prefer raw JWT
# without a Bearer prefix; the server normalizes Authorization headers.
SUNFIRE_JWT=
SUNFIRE_SFP=

PORT=3002

# Optional: comma-separated extra browser origins for CORS
# EXTRA_CORS_ORIGINS=https://my-preview.netlify.app

# Optional limits
# MAX_CLIENT_SYSTEM_CHARS=400000
# MAX_CHAT_MESSAGES=40
