# Max Guru Backend — required environment variables
# Set these in Railway → Variables

# LLM provider: grok (default) or openai
LLM_PROVIDER=openai

# --- OpenAI (when LLM_PROVIDER=openai) ---
OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4.1
# OPENAI_API_BASE=https://api.openai.com/v1

# --- xAI Grok (when LLM_PROVIDER=grok) ---
# XAI_API_KEY=xai-...
# GROK_MODEL=grok-4.6
# XAI_API_BASE=https://api.x.ai/v1

# Auth — shared secret between frontend and this backend
MAX_API_KEY=your-secret-key-here

# Invite-only gate
MAX_ACCESS_PASSWORD=choose-a-strong-shared-password

# Cost guards
# MAX_CHAT_RATE_MAX=40
# MAX_CHAT_RATE_WINDOW_MS=3600000
# Browser aborts /chat at 85s (live UI) / 120s after frontend PR.
# Keep server deadline under the browser abort so pink "still working" is avoided.
# MAX_CHAT_DEADLINE_MS=78000
# MAX_GROK_FETCH_MS=40000
MAX_DAILY_BUDGET_USD=10
MAX_SOFT_WARN_PCT=50,80
# Set this to a mounted Railway volume path so the same ET day's ledger survives restarts.
# MAX_USAGE_FILE=/data/max-usage.json
# Client workups (Save/Open across desktop + phone). Same volume as usage.
# MAX_WORKUPS_FILE=/data/max-workups.json
# MAX_WORKUPS_PER_OWNER=50
# Optional model-price overrides, USD per 1M tokens (use when changing models).
# MAX_MODEL_INPUT_USD_PER_M=2
# MAX_MODEL_CACHED_INPUT_USD_PER_M=0.5
# MAX_MODEL_OUTPUT_USD_PER_M=6
# MAX_CONTEXT_NUDGE_TOKENS=120000

# Sunfire
SUNFIRE_JWT=your-sunfire-jwt-token
SUNFIRE_SFP=your-sunfire-sfp-cookie

PORT=3002

# Comma-separated emails allowed to unlock Max (with MAX_ACCESS_PASSWORD)
MAX_ACCESS_EMAILS=carolina@healthexps.com,krobles@healthexps.com,yperez@healthexps.com
