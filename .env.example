# Max Guru Backend — required environment variables
# Set these in Railway → Variables

# xAI Grok (required — Max runs on Grok)
XAI_API_KEY=xai-...
# Optional overrides:
# GROK_MODEL=grok-4.6
# XAI_API_BASE=https://api.x.ai/v1

# Auth — shared secret between frontend and this backend
# Generate with: openssl rand -hex 32
MAX_API_KEY=your-secret-key-here

# Sunfire (browser session tokens — rotate when expired)
SUNFIRE_JWT=your-sunfire-jwt-token
SUNFIRE_SFP=your-sunfire-sfp-cookie

# Optional
PORT=3002
# MAX_CLIENT_SYSTEM_CHARS=400000

# Legacy (no longer used by /chat — safe to remove after cutover)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-4-6
